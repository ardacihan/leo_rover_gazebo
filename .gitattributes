# Rover scripts are executed on Linux via a `#!/usr/bin/env python3` shebang.
# A CRLF checkout makes the kernel look for an interpreter named "python3\r",
# which fails at launch, so keep these files LF regardless of platform.
*.py text eol=lf
*.sh text eol=lf
*.launch text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
# Shell scripts also run inside the WSL/Linux sim containers.
docker-entrypoint.sh text eol=lf
# PowerShell scripts are fine either way; keep platform default
*.ps1 text
