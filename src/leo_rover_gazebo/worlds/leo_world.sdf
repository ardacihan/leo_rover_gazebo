<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="leo_world">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.2 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.2 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 20 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 20 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 20 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 20 2</size></box></geometry></visual>
      </link>
    </model>

    <!-- Interior walls: rooms with 2 m doorways for exploration testing -->
    <model name="wall_inner_w_south">
      <static>true</static>
      <pose>-4 -6.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 7 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 7 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_inner_w_mid">
      <static>true</static>
      <pose>-4 1.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 5 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 5 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_inner_w_north">
      <static>true</static>
      <pose>-4 8 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 4 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 4 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_inner_n_left">
      <static>true</static>
      <pose>1 4 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.2 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_inner_n_right">
      <static>true</static>
      <pose>8 4 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4 0.2 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_inner_se">
      <static>true</static>
      <pose>5 -4 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.2 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_inner_s_stub">
      <static>true</static>
      <pose>2 -8.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3 2</size></box></geometry></visual>
      </link>
    </model>

    <!-- Free-standing obstacles -->
    <model name="crate_1">
      <static>true</static>
      <pose>6 1 0.5 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 1 1</size></box></geometry></visual>
      </link>
    </model>

    <model name="crate_2">
      <static>true</static>
      <pose>-1 -6 0.5 0 0 -0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1.5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1.5 1</size></box></geometry></visual>
      </link>
    </model>

    <model name="pillar_1">
      <static>true</static>
      <pose>-7 5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>2</length></cylinder></geometry></visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>7 7 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>2</length></cylinder></geometry></visual>
      </link>
    </model>

    <!-- Visual "ArUco" markers (poses mirror
         leo_rover_exploration/config/mock_markers_leo_world.yaml) -->
    <model name="marker_1">
      <static>true</static>
      <pose>-9.88 -6.0 0.3 0 0 0.0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="marker_2">
      <static>true</static>
      <pose>-7.0 9.88 0.3 0 0 -1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="marker_3">
      <static>true</static>
      <pose>-4.12 2.0 0.3 0 0 3.1416</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="marker_4">
      <static>true</static>
      <pose>0.0 3.88 0.3 0 0 -1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="marker_5">
      <static>true</static>
      <pose>9.88 -7.0 0.3 0 0 3.1416</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="marker_6">
      <static>true</static>
      <pose>5.0 -3.88 0.3 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>