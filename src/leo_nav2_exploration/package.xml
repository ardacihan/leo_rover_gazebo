<?xml version="1.0"?>
<package format="3">
  <name>leo_nav2_exploration</name>
  <version>0.1.0</version>
  <description>Standalone Nav2 and SLAM overlay for robust Leo Rover doorway navigation and exploration.</description>
  <maintainer email="smiv@example.com">SmiV Project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>frontier_exploration_ros2</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>dwb_critics</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_rotation_shim_controller</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <!-- planner plugin loaded by nav2_planner (config/*/nav2.yaml) -->
  <exec_depend>nav2_navfn_planner</exec_depend>
  <!-- ekf_node, launch/odometry_fusion.launch.py -->
  <exec_depend>robot_localization</exec_depend>
  <!-- leo_msgs/Imu, consumed by leo_imu_bridge -->
  <exec_depend>leo_msgs</exec_depend>
  <!-- cv2.aruco, used by aruco_detector -->
  <exec_depend>python3-opencv</exec_depend>
  <!-- launch/real_exploration.launch.py -->
  <exec_depend>explore_lite</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
