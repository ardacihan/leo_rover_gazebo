# --- Third-party clones (nested git repos; fetch, do not vendor) ---
# frontier_exploration_ros2 is pinned in bundle_ref/dependencies.repos:
#   vcs import src < bundle_ref/dependencies.repos
src/frontier_exploration_ros2/
src/m-explore-ros2/
src/husarion_gz_worlds/

# --- Overnight experiment run outputs (2026-08-17) ---
# ~36 MB of maps, time-lapses, pose CSVs and stack logs. The written findings
# and the self-contained dashboard are tracked; the raw runs stay on disk.
# Regenerate: scripts/exp_run.sh -> scripts/exp_score.sh -> scripts/exp_compare.py
reports/exp/**
!reports/exp/FINDINGS.md
!reports/exp/BUNDLE_BUGS.md
!reports/exp/comparison.md
!reports/exp/dashboard.html

# Older local run artifacts
reports/slam_bench*/
reports/slam_smoke/
reports/slam_verify/
reports/sim_run_*/
reports/*.log
reports/*.png
reports/*.json

# --- merged in from fix/real-rover-mapping (2026-08-23) ---
# Generated ROS maps and media
artifacts/
maps/
*.pdf

# ChatGPT / Repomix context exports (may contain lab details)
chatgpt_context/

# Local rosbag recordings (multi-GB) and deploy bundles
bags/
src/leo_real_mapping_bundle.zip

# Colcon output, including the vendored semantic-vision tree
src/**/build/
src/**/install/
src/**/log/
build/
install/
log/

# Raw per-frame run capture: regenerable from the bags via scripts/render_run.py.
# The committed figures, maps, events.jsonl and report.html are what matter.
reports/**/*.npz
reports/**/*.tar.gz
reports/**/render/
reports/**/video/
reports/**/*.log
reports/**/*.log.gz
.run_snapshots/

# Raw camera capture from two-rover runs: hundreds of full-size PNGs, and
# compressed copies of the ones worth looking at are already embedded in
# reports/**/dashboard.html. Re-generated by scripts/frame_grabber.py on any run.
reports/**/frames_leo*/
# Per-snapshot occupancy grids for the merge time-lapse (already covered by the
# *.npz rule above, listed here so the intent is obvious).
reports/**/timelapse/
